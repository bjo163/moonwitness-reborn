{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "${configDir}",
    "outDir": "${configDir}/dist",
    "types": ["node"]
  },
  "include": [
    "${configDir}/__manifest__.ts",
    "${configDir}/models/**/*.ts",
    "${configDir}/services/**/*.ts",
    "${configDir}/views/**/*.ts"
  ]
}
