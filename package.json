{
  "name": "moonwitness",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm lint && turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint apps packages",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "tracker:render": "python -B docs/audit/tools/task_tracker.py --write",
    "tracker:check": "python -B docs/audit/tools/task_tracker.py --check",
    "tracker:test": "python -B docs/audit/tools/test_task_tracker.py"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@moonwitness/eslint-config": "workspace:*",
    "@next/eslint-plugin-next": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "pnpm@10.33.1"
}
