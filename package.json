{
  "name": "moonwitness",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build && pnpm lint",
    "dev": "node scripts/dev-preflight.mjs",
    "lint": "eslint apps packages",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "i18n:sync": "node scripts/sync-po-catalogs.mjs",
    "i18n:sync:check": "node scripts/sync-po-catalogs.mjs --check",
    "ui:check": "node scripts/check-ui-consistency.mjs",
    "verify:package-conventions": "node scripts/verify-package-conventions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@moonwitness/eslint-config": "workspace:*",
    "@next/eslint-plugin-next": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "pnpm@10.33.1"
}
