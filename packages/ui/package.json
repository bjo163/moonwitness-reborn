{
  "name": "@moonwitness/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": ["./styles.css", "./styles/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./preset.css": "./styles/preset.css",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/base.css": "./styles/base.css",
    "./styles/components.css": "./styles/components.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/composites.test.tsx tests/class-name-contract.test.tsx tests/tokens.test.ts tests/quran-text.test.tsx tests/batch2-spatial.test.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "peerDependencies": {
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:"
  }
}
