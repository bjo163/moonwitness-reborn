msgctxt "web:landing.title"
msgid "Menjaga pengetahuan. Menelusuri sumber. Memahami konteks."
msgstr "Preserve knowledge. Trace sources. Understand context."

msgctxt "web:landing.description"
msgid ""
"MoonWitness adalah platform perangkat lunak dalam ekosistem A-L-L-A-H.COM—"
"dibangun untuk membantu orang menjaga pengetahuan, menelusuri sumber, "
"memahami konteks, dan bertindak secara bertanggung jawab."
msgstr ""
"MoonWitness is a software platform within the A-L-L-A-H.COM ecosystem—built "
"to help people preserve knowledge, trace sources, understand context, and "
"act responsibly."

msgctxt "web:landing.ecosystemRelation"
msgid "Satu platform produk di dalam ekosistem A-L-L-A-H.COM."
msgstr "One product platform within the A-L-L-A-H.COM ecosystem."

msgctxt "web:landing.ecosystemContextTitle"
msgid "Bagian dari ekosistem A-L-L-A-H.COM"
msgstr "Part of the A-L-L-A-H.COM ecosystem"

msgctxt "web:landing.ecosystemContext"
msgid ""
"A-L-L-A-H.COM adalah identitas publik dan gerbang ekosistem yang mendorong "
"pembelajaran, teknologi yang bertanggung jawab, kreativitas, dan kontribusi "
"bermakna. MoonWitness adalah platform perangkat lunak terintegrasi di "
"dalamnya—bukan keseluruhan ekosistem."
msgstr ""
"A-L-L-A-H.COM is the ecosystem's public identity and gateway, encouraging "
"learning, responsible technology, creativity, and meaningful contribution. "
"MoonWitness is an integrated software platform within it—not the whole "
"ecosystem."

msgctxt "web:landing.ecosystemLinkLabel"
msgid "Tentang hubungan ekosistem"
msgstr "About the ecosystem relationship"

