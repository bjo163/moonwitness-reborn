msgctxt "web:community.commTitle"
msgid "Dock · Pelabuhan Komunitas"
msgstr "Dock · Community Harbor"

msgctxt "web:community.commSubtitle"
msgid "Ruang Kolaborasi & Kontribusi Ekosistem A-L-L-A-H.COM"
msgstr "Collaboration & Contribution Space of A-L-L-A-H.COM"

msgctxt "web:community.commHero"
msgid "Kebenaran di Atas Opini. Amal Nyata di Atas Klaim."
msgstr "Truth Over Opinion. Real Action Over Claims."

msgctxt "web:community.commDesc"
msgid "Dock adalah pelabuhan partisipasi tempat para peneliti, penggiat ilmu, dan pencari kebenaran berhimpun untuk mengkaji sumber dan berkontribusi secara bertanggung jawab."
msgstr "Dock is the participation harbor where researchers, knowledge seekers, and builders gather to examine sources and contribute responsibly."

msgctxt "web:community.commGuidelinesTitle"
msgid "Etika & Pedoman Partisipasi"
msgstr "Ethics & Participation Guidelines"

msgctxt "web:community.commGuideline1"
msgid "Integritas Rujukan"
msgstr "Integrity of References"

msgctxt "web:community.commGuideline1Desc"
msgid "Setiap gagasan atau klaim wajib menyertakan rujukan primer yang dapat diperiksa bersama."
msgstr "Every idea or claim must provide primary sources that can be openly examined."

msgctxt "web:community.commGuideline2"
msgid "Adab Diskusi & Kerendahan Hati"
msgstr "Manners & Humility"

msgctxt "web:community.commGuideline2Desc"
msgid "Menghormati martabat sesama manusia, menghindari debat kusir tanpa dalil, dan senantiasa mencari kebenaran."
msgstr "Respecting human dignity, avoiding baseless arguments, and perpetually seeking truth."

msgctxt "web:community.commGuideline3"
msgid "Akuntabilitas Amal"
msgstr "Accountability of Deeds"

msgctxt "web:community.commGuideline3Desc"
msgid "Kontribusi diarahkan pada kemanfaatan nyata bagi umat dan kemanusiaan, bukan popularitas semu."
msgstr "Contributions are directed toward real benefit for humanity, not superficial popularity."

