{
  "name": "ql_corpus",
  "private": true,
  "type": "module",
  "exports": {
    "./__manifest__": {
      "types": "./dist/__manifest__.d.ts",
      "import": "./dist/__manifest__.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./views": {
      "types": "./dist/views/index.d.ts",
      "import": "./dist/views/index.js"
    },
    "./services/corpus-vocabulary": {
      "types": "./dist/services/corpus-vocabulary.d.ts",
      "import": "./dist/services/corpus-vocabulary.js"
    },
    "./services/field-validators": {
      "types": "./dist/services/field-validators.d.ts",
      "import": "./dist/services/field-validators.js"
    },
    "./services/corpus-service": {
      "types": "./dist/services/corpus-service.d.ts",
      "import": "./dist/services/corpus-service.js"
    },
    "./services/reader-service": {
      "types": "./dist/services/reader-service.d.ts",
      "import": "./dist/services/reader-service.js"
    },
    "./services/proof-service": {
      "types": "./dist/services/proof-service.d.ts",
      "import": "./dist/services/proof-service.js"
    },
    "./services/import-service": {
      "types": "./dist/services/import-service.d.ts",
      "import": "./dist/services/import-service.js"
    },
    "./services/import-quran-cli": {
      "types": "./dist/services/import-quran-cli.d.ts",
      "import": "./dist/services/import-quran-cli.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test models/index.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "import:quran": "tsx services/import-quran-cli.ts"
  },
  "dependencies": {
    "@moonwitness/types": "workspace:*",
    "ql_auth": "workspace:*",
    "ql_base": "workspace:*",
    "ql_orm": "workspace:*",
    "ql_source": "workspace:*"
  },
  "devDependencies": {
    "tsx": "catalog:"
  }
}
