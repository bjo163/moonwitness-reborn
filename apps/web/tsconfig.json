{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    ".next-budget/types/**/*.ts",
    ".next-i18n-preview/types/**/*.ts",
    ".next-size-check/types/**/*.ts",
    ".next-verify-ui/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify3003/types/**/*.ts",
    ".next-verify3007/types/**/*.ts",
    ".next-verify3008/types/**/*.ts",
    ".next-verify3009/types/**/*.ts",
    ".next-verify3010/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next-verify/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
