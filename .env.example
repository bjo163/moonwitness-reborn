PORT=3000
# QlOrm memakai @libsql/client, jadi URL harus LibSQL/SQLite (file: atau libsql://).
# QlOrm mendukung dua dialect: skema LibSQL/SQLite maupun Postgres; driver dipilih dari DATABASE_URL
# Service Postgres di docker-compose.yml baru terpakai setelah packages/ql-orm pindah ke driver pg.
DATABASE_URL=file:../../data/moonwitness.db
# Generate a local 32-byte key (64 hex characters) with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PROVIDER_ENCRYPTION_KEY=
# Optional one-time root claim: both must be set, and the matching email is the
# first account registered while no super_admin exists. Unset both afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_TOKEN=
# Optional server-wide fallback. Prefer configuring personal providers in /providers.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=
