PORT=3000
# Default: local Turso/LibSQL (SQLite-compatible) file.
# For Postgres (see docker-compose.yml), use e.g.:
#   postgres://moonwitness:moonwitness@localhost:5432/moonwitness
DATABASE_URL=file:../../data/moonwitness.db
# Generate a local 32-byte key (64 hex characters) with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PROVIDER_ENCRYPTION_KEY=
# Optional server-wide fallback. Prefer configuring personal providers in /providers.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=
