PORT=3000
# Untuk API yang berjalan di host (`pnpm dev`); port host PostgreSQL di Compose.
DATABASE_URL=postgresql://moonwitness:moonwitness@127.0.0.1:5434/moonwitness
# Hanya untuk API di dalam Docker Compose; hostname `postgres` tidak tersedia dari host.
DATABASE_URL_CONTAINER=postgresql://moonwitness:moonwitness@postgres:5432/moonwitness
# Generate a local 32-byte key (64 hex characters) with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PROVIDER_ENCRYPTION_KEY=
# Optional one-time root claim: both must be set, and the matching email is the
# first account registered while no super_admin exists. Unset both afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_TOKEN=
# Optional server-wide fallback. Prefer configuring personal providers in /providers.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=
# Optional server-only token for higher-rate read access to public task Issues.
GITHUB_TOKEN=
# Attachment storage (ql_attachment). Bytes live on disk under this directory and
# are never stored in a database column. Only the local-disk driver exists today.
ATTACHMENT_STORAGE_DIR=./data/attachments
# Per-user total attachment quota in bytes, and the free space the volume must
# still have before an upload is accepted.
ATTACHMENT_USER_QUOTA_BYTES=2147483648
ATTACHMENT_MIN_FREE_BYTES=536870912
# Upload chunk size in bytes (262144 to 8388608) and how long an interrupted
# upload session may be resumed.
ATTACHMENT_CHUNK_BYTES=4194304
ATTACHMENT_UPLOAD_TTL_MS=21600000
